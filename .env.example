# OkuGym environment — ALL OPTIONAL.
# server.js ships safe defaults, so an empty file works too.
# Copy to `.env` to override: cp .env.example .env

# Internal API port (nginx proxies here) — normally leave as 3000
PORT=3000
DATA_DIR=/data

# Public origin used for passkey/WebAuthn + web-push.
# Set this to your real domain when deploying (e.g. https://gym.example.com)
ORIGIN=http://localhost:8080
RP_ID=localhost
RP_NAME=OkuGym

# TLS flag — set true behind HTTPS so Secure cookies / push work
SECURE=false

# VAPID keys for web-push (optional; auto-generated if blank)
VAPID_SUBJECT=mailto:admin@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
